{
  "name": "scope-di",
  "scripts": {
    "bench:tsx": "pnpm --filter @svs-tm/core-benchmarks run bench:tsx",
    "bench:tsx:fast": "pnpm --filter @svs-tm/core-benchmarks run bench:tsx:fast",
    "bench:tsx:complete": "pnpm --filter @svs-tm/core-benchmarks run bench:tsx:complete",
    "bench:tsx:json": "pnpm --filter @svs-tm/core-benchmarks run bench:tsx:json",
    "bench:tsx:json:fast": "pnpm --filter @svs-tm/core-benchmarks run bench:tsx:json:fast",
    "bench:tsx:json:complete": "pnpm --filter @svs-tm/core-benchmarks run bench:tsx:json:complete",
    "bench:deno": "pnpm --filter @svs-tm/core-benchmarks run bench:deno",
    "bench:deno:fast": "pnpm --filter @svs-tm/core-benchmarks run bench:deno:fast",
    "bench:deno:complete": "pnpm --filter @svs-tm/core-benchmarks run bench:deno:complete",
    "bench:deno:json": "pnpm --filter @svs-tm/core-benchmarks run bench:deno:json",
    "bench:deno:json:fast": "pnpm --filter @svs-tm/core-benchmarks run bench:deno:json:fast",
    "bench:deno:json:complete": "pnpm --filter @svs-tm/core-benchmarks run bench:deno:json:complete",
    "bench:bun": "pnpm --filter @svs-tm/core-benchmarks run bench:bun",
    "bench:bun:fast": "pnpm --filter @svs-tm/core-benchmarks run bench:bun:fast",
    "bench:bun:complete": "pnpm --filter @svs-tm/core-benchmarks run bench:bun:complete",
    "bench:bun:json": "pnpm --filter @svs-tm/core-benchmarks run bench:bun:json",
    "bench:bun:json:fast": "pnpm --filter @svs-tm/core-benchmarks run bench:bun:json:fast",
    "bench:bun:json:complete": "pnpm --filter @svs-tm/core-benchmarks run bench:bun:json:complete",
    "bench:json:complete": "pnpm --filter @svs-tm/core-benchmarks run bench:json:complete",
    "build-all": "pnpm -r build",
    "pack-all": "pnpm -r pack",
    "test-all": "pnpm -r test"
  },
  "packageManager": "pnpm@12.10.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    },
    "runtime": [
      {
        "name": "node",
        "version": "26.11.1",
        "onFail": "download"
      },
      {
        "name": "bun",
        "version": "1.4.2",
        "onFail": "download"
      },
      {
        "name": "deno",
        "version": "2.9.6",
        "onFail": "download"
      }
    ]
  }
}
