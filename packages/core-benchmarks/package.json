{
  "name": "@svs-tm/core-benchmarks",
  "type": "module",
  "description": "Scope DI core benchmarks",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "bench:tsx": "tsx --tsconfig ./tsconfig.build.json --expose-gc src/main.ts",
    "bench:tsx:fast": "tsx --tsconfig ./tsconfig.build.json --expose-gc src/main.ts --mode=fast",
    "bench:tsx:complete": "tsx --tsconfig ./tsconfig.build.json --expose-gc src/main.ts --mode=complete",
    "bench:tsx:json": "tsx --tsconfig ./tsconfig.build.json --expose-gc src/main.ts --json",
    "bench:tsx:json:fast": "tsx --tsconfig ./tsconfig.build.json --expose-gc src/main.ts --json --mode=fast",
    "bench:tsx:json:complete": "tsx --tsconfig ./tsconfig.build.json --expose-gc src/main.ts --json --mode=complete",
    "bench:deno": "deno run --allow-sys=cpus --import-map=deno.json --v8-flags=--expose-gc src/main.ts",
    "bench:deno:fast": "deno run --allow-sys=cpus --import-map=deno.json --v8-flags=--expose-gc src/main.ts --mode=fast",
    "bench:deno:complete": "deno run --allow-sys=cpus --import-map=deno.json --v8-flags=--expose-gc src/main.ts --mode=complete",
    "bench:deno:json": "deno run --allow-sys=cpus --import-map=deno.json --v8-flags=--expose-gc src/main.ts --json",
    "bench:deno:json:fast": "deno run --allow-sys=cpus --import-map=deno.json --v8-flags=--expose-gc src/main.ts --json --mode=fast",
    "bench:deno:json:complete": "deno run --allow-sys=cpus --import-map=deno.json --v8-flags=--expose-gc src/main.ts --json --mode=complete",
    "bench:bun": "bun --tsconfig-override ./tsconfig.build.json --expose-gc src/main.ts",
    "bench:bun:fast": "bun --tsconfig-override ./tsconfig.build.json --expose-gc src/main.ts --mode=fast",
    "bench:bun:complete": "bun --tsconfig-override ./tsconfig.build.json --expose-gc src/main.ts --mode=complete",
    "bench:bun:json": "bun --tsconfig-override ./tsconfig.build.json --expose-gc src/main.ts --json",
    "bench:bun:json:fast": "bun --tsconfig-override ./tsconfig.build.json --expose-gc src/main.ts --json --mode=fast",
    "bench:bun:json:complete": "bun --tsconfig-override ./tsconfig.build.json --expose-gc src/main.ts --json --mode=complete"
  },
  "author": "svs-tm",
  "license": "ISC",
  "dependencies": {
    "@needle-di/core": "^1.1.2",
    "@svs-tm/scope-di": "workspace:*",
    "@svs-tm/system": "workspace:*",
    "awilix": "^13.0.4",
    "inversify": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typed-inject": "^5.0.0",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "bun-types": "^1.3.2",
    "mitata": "^1.0.34",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.16.0",
    "bun": ">=1.3.2",
    "deno": ">=2.5.6"
  }
}
