{
    "name": "@svs-tm/system",
    "version": "1.0.0-alpha.3",
    "description": "Runtime and type utilities used by the Scope DI packages",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist/index.cjs",
        "dist/index.cjs.map",
        "dist/index.d.ts",
        "dist/index.mjs",
        "dist/index.mjs.map"
    ],
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SvS-tm/scope-di.git",
        "directory": "packages/system"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsc && rollup -c ts.rollup.config.mjs && rollup -c dts.rollup.config.mjs",
        "test": "pnpm run test:runtime && pnpm run test:types",
        "test:runtime": "jest",
        "test:types": "tstyche"
    },
    "keywords": [
        "typescript",
        "utilities",
        "helpers"
    ],
    "author": "svs-tm",
    "license": "MIT",
    "devDependencies": {
        "@jest/globals": "^30.0.5",
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@swc/core": "^1.15.21",
        "@swc/jest": "^0.2.39",
        "@types/node": "^24.1.0",
        "esbuild-register": "^3.6.0",
        "jest": "^30.2.0",
        "jest-junit": "^17.0.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.0",
        "rollup-plugin-dts": "^6.2.3",
        "tstyche": "^7.2.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.2"
    }
}
