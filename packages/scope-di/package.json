{
    "name": "@svs-tm/scope-di",
    "version": "1.1.0",
    "description": "Type-safe dependency injection for TypeScript without decorators or reflect-metadata",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files":
    [
        "dist/index.cjs",
        "dist/index.cjs.map",
        "dist/index.d.ts",
        "dist/index.mjs",
        "dist/index.mjs.map",
        "dist/chunks"
    ],
    "repository":
    {
        "type": "git",
        "url": "git+https://github.com/SvS-tm/scope-di.git",
        "directory": "packages/scope-di"
    },
    "sideEffects": false,
    "exports":
    {
        ".":
        {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts":
    {
        "build": "pnpm run typecheck:tooling && tsc --project .build/tsconfig.declarations.json && rollup -c .build/rollup/ts.rollup.config.ts --configImportAttributesKey with --configPlugin \"typescript={tsconfig:'.build/rollup/tsconfig.rollup.json'}\" && rollup -c .build/rollup/dts.rollup.config.ts --configImportAttributesKey with --configPlugin \"typescript={tsconfig:'.build/rollup/tsconfig.rollup.json'}\"",
        "test": "pnpm run test:runtime && pnpm run test:types",
        "test:runtime": "jest --config .build/jest/jest.config.ts",
        "test:types": "tstyche --config .build/tstyche/tstyche.json",
        "typecheck:tooling": "tsc --project .build/rollup/tsconfig.rollup.json --noEmit"
    },
    "keywords":
    [
        "dependency-injection",
        "di",
        "ioc",
        "typescript",
        "type-safe",
        "no-decorators",
        "react"
    ],
    "author": "svs-tm",
    "license": "MIT",
    "dependencies":
    {
        "@svs-tm/system": "workspace:*"
    },
    "peerDependencies":
    {
        "typescript": ">=5 <7"
    },
    "peerDependenciesMeta":
    {
        "typescript":
        {
            "optional": true
        }
    },
    "devDependencies":
    {
        "@jest/globals": "^30.0.5",
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.1",
        "@swc/core": "^1.15.21",
        "@swc/jest": "^0.2.39",
        "@types/node": "^24.1.0",
        "esbuild-register": "^3.6.0",
        "jest": "^30.2.0",
        "jest-junit": "^17.0.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.67.4",
        "rollup-plugin-dts": "^6.5.1",
        "tslib": "^2.8.1",
        "tstyche": "^7.2.1",
        "typescript": "^6.0.3"
    }
}
