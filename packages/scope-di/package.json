{
    "name": "@svs-tm/scope-di",
    "version": "1.0.0-alpha.3",
    "description": "Type-safe dependency injection for TypeScript without decorators or reflect-metadata",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist/index.cjs",
        "dist/index.cjs.map",
        "dist/index.d.ts",
        "dist/index.mjs",
        "dist/index.mjs.map"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SvS-tm/scope-di.git",
        "directory": "packages/scope-di"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json && rollup -c ts.rollup.config.mjs && rollup -c dts.rollup.config.mjs",
        "test": "pnpm run test:runtime && pnpm run test:types",
        "test:runtime": "jest",
        "test:types": "tsd --files \"src/**/*.compiletime.test.ts\""
    },
    "keywords": [
        "dependency-injection",
        "di",
        "ioc",
        "typescript",
        "type-safe",
        "no-decorators",
        "react"
    ],
    "author": "svs-tm",
    "license": "MIT",
    "dependencies": {
        "@svs-tm/system": "workspace:*"
    },
    "devDependencies": {
        "@jest/globals": "^30.0.5",
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@swc/core": "^1.15.21",
        "@swc/jest": "^0.2.39",
        "@types/node": "^24.1.0",
        "esbuild-register": "^3.6.0",
        "jest": "^30.2.0",
        "jest-junit": "^17.0.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.0",
        "rollup-plugin-dts": "^6.2.3",
        "tsd": "^0.33.0",
        "typescript": "^5.9.2"
    }
}
