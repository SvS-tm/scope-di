{
    "extends": "./tsconfig.common.json",
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2022",
        "moduleResolution": "node",
        "lib": [
            // gives TS 5.2+ `using` & symbols
            "esnext"
        ], 
        // allow full type-aware transform
        "isolatedModules": false, 
        // don't emit in tests
        "noEmit": true
    },
    "include": [
        "src/**/*.runtime.test.ts",
        "src/tests-setup.ts"
    ],
    "exclude": []
}
