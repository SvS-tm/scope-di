{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2022",
        "moduleResolution": "node",
        "lib": [
            // gives TS 5.2+ `using` & symbols
            "esnext",
            "DOM"
        ], 
        // allow full type-aware transform
        "isolatedModules": false, 
        // don't emit in tests
        "noEmit": true
    },
    "include": [
        "src/**/*.test.ts"
    ],
    "exclude": [
        ".rollup.cache",
        "dist"
    ]
}
