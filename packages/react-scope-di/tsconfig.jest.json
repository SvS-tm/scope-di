{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2022",
        "moduleResolution": "node",
        "lib": [
            "esnext",
            "DOM"
        ], 
        // allow full type-aware transform
        "isolatedModules": false, 
        "noEmit": true
    },
    "include": [
        "src/**/*.test.ts",
        "src/tests-setup.after-env.ts",
        "src/tests-setup.ts",
        "src/tests-extensions.d.ts"
    ],
    "exclude": [
        ".rollup.cache",
        "dist"
    ]
}
