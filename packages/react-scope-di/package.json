{
    "name": "@svs-tm/react-scope-di",
    "version": "1.0.0-alpha.4",
    "description": "React bindings for Scope DI with typed injection and async dependency support",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist/index.cjs",
        "dist/index.cjs.map",
        "dist/index.d.ts",
        "dist/index.mjs",
        "dist/index.mjs.map"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SvS-tm/scope-di.git",
        "directory": "packages/react-scope-di"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json && rollup -c ts.rollup.config.mjs && rollup -c dts.rollup.config.mjs",
        "test": "pnpm run test:runtime && pnpm run test:types",
        "test:runtime": "jest",
        "test:types": "tsd --files \"src/**/*.compiletime.test.tsx\""
    },
    "keywords": [
        "react",
        "dependency-injection",
        "di",
        "ioc",
        "typescript",
        "suspense",
        "hooks"
    ],
    "author": "svs-tm",
    "license": "MIT",
    "dependencies": {
        "@svs-tm/system": "workspace:*"
    },
    "devDependencies": {
        "@jest/globals": "^30.0.5",
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@svs-tm/scope-di": "workspace:*",
        "@swc/core": "^1.15.21",
        "@swc/jest": "^0.2.39",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.6.4",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^24.1.0",
        "@types/react": "^19.1.9",
        "@types/react18": "npm:@types/react@^18.3.23",
        "@types/react19": "npm:@types/react@^19.1.9",
        "core-js": "^3.46.0",
        "esbuild-register": "^3.6.0",
        "expect": "^30.2.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jest-junit": "^17.0.0",
        "jest-mock": "^30.2.0",
        "react": "^19.1.1",
        "react-dom18": "npm:react-dom@^18.3.1",
        "react-dom19": "npm:react-dom@^19.1.1",
        "react18": "npm:react@^18.3.1",
        "react19": "npm:react@^19.1.1",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.0",
        "rollup-plugin-dts": "^6.2.3",
        "tsd": "^0.33.0",
        "typescript": "^5.9.2"
    },
    "peerDependencies": {
        "@svs-tm/scope-di": "^1.0.0-alpha.0 || >=1 <2",
        "react": ">=18 <20"
    },
    "engines": {
        "node": ">=18"
    }
}
